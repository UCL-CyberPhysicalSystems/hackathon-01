# Base image
ARG ISAAC_MAJOR=5
ARG ISAAC_MINOR=0
ARG ISAAC_PATCH=0

FROM nvcr.io/nvidia/isaac-sim:${ISAAC_MAJOR}.${ISAAC_MINOR}.${ISAAC_PATCH}

# Environment setup
ENV DEBIAN_FRONTEND=noninteractive \
    ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    LANG=en_GB.UTF-8 \
    LC_ALL=en_GB.UTF-8 \
    TZ=Europe/London \
    ROS_DISTRO=humble \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3 \
    SHELL=/bin/bash

# Timezone setup
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# Optimize apt operations and install base dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    locales \
    curl \
    gnupg2 \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Configure locale
RUN locale-gen en_GB.UTF-8 && update-locale LC_ALL=${LC_ALL} LANG=${LANG}

# Add ROS 2 repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install Python and build tools in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-full \
    python3-pip \
    python3-rosdep \
    python3-colcon-common-extensions \
    python3-vcstool \
    python3-setuptools \
    python3-wheel \
    python3-osrf-pycommon \
    build-essential \
    cmake \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install ROS 2 desktop and required libbrotli version
RUN apt-get update && apt-get install -y --no-install-recommends --allow-downgrades \
    libbrotli1=1.0.9-2build6 \
    ros-${ROS_DISTRO}-desktop \
    && rm -rf /var/lib/apt/lists/*

# Install ROS 2 bridge packages and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core ROS 2 packages
    ros-${ROS_DISTRO}-demo-nodes-cpp \
    ros-${ROS_DISTRO}-demo-nodes-py \
    ros-${ROS_DISTRO}-turtlesim \
    # ROS 2 bridge packages
    ros-${ROS_DISTRO}-ros-gz-bridge \
    ros-${ROS_DISTRO}-ros-gz-sim \
    # ROS 2 message packages
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-nav-msgs \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-xacro \
    # ROS 2 tools
    ros-${ROS_DISTRO}-rqt* \
    && rm -rf /var/lib/apt/lists/*

# Install development tools and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    gdb \
    git-core \
    openssh-client \
    file \
    tree \
    wget \
    less \
    udev \
    sudo \
    libpng-dev \
    libgomp1 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libmagic1 \
    libxext6 \
    libxrender-dev \
    tree \
    tmux \
    curl \
    vim \
    xclip \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# Initialize rosdep (with error handling)
RUN rosdep init || echo "rosdep init failed or already initialized" && \
    rosdep update --rosdistro=${ROS_DISTRO} || echo "rosdep update failed"

# Create directories for volumes before declaring them
RUN mkdir -p /isaac-sim/kit/cache \
    /root/.cache/ov \
    /root/.cache/pip \
    /root/.cache/nvidia/GLCache \
    /root/.nv/ComputeCache \
    /root/.nvidia-omniverse/logs \
    /root/.local/share/ov/data \
    /root/Documents

# Set up volumes for caches and data
VOLUME ["/isaac-sim/kit/cache", "/root/.cache/ov", "/root/.cache/pip", "/root/.cache/nvidia/GLCache", "/root/.nv/ComputeCache", "/root/.nvidia-omniverse/logs", "/root/.local/share/ov/data", "/root/Documents"]

# ROS2 environment setup - optimized
SHELL ["/bin/bash", "-c"]
RUN echo -e '\n## ROS2\nsource /opt/ros/${ROS_DISTRO}/setup.bash' >> ~/.bashrc

# Create a non-root user (optional but recommended for security)
ARG USERNAME=rosuser
ARG USER_UID=1001
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID -m $USERNAME && \
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME

# Switch to non-root user (optional - comment out to run as root)
# USER $USERNAME
# WORKDIR /home/$USERNAME

# Default command
CMD ["bash"]